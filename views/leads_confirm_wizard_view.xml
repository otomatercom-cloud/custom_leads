                            <strong>🔔 Today's Follow-up:</strong>
                            <field name="today_followup_message" readonly="1" nolabel="1"/>
                        </div>
                        <button name="action_dismiss_message" icon="fa-times" type="object" class="btn btn-sm btn-link text-danger" title="Dismiss" confirm="Dismiss this message?"/>
                    </div>
                </div>

                    <group>
                        <field name="name"/>
<!--                        <field name="phone_number"/>-->
                        <field name="lead_owner_id" widget="many2one_avatar_user"/>
                        <field name="created_by_id" widget="many2one_avatar_user"/>
                        <field name="lead_quality" invisible="1"/>
                        <field name="whatsapp_intro" invisible="1"/>
                        <field name="testimonials" invisible="1"/>
                        <field name="results_highlights" invisible="1"/>
                        <field name="second_follow_up" invisible="1"/>
                        <field name="sent_webinar" invisible="1"/>
                        <field name="third_call" invisible="1"/>
                        <field name="touches_complete" invisible="1"/>
