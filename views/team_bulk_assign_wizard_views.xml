<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_team_bulk_assign_wizard_form" model="ir.ui.view">
        <field name="name">team.bulk.assign.wizard.form</field>
        <field name="model">team.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Admission Officers">
                <group>
                    <field name="team_id" options="{'no_create': True}"/>
                    <field name="team_lead_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <field name="user_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="Select Admission Officers to assign to this team..."/>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_team_bulk_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign to Team</field>
        <field name="res_model">team.bulk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bulk action available from the Admission Officers list view (select multiple rows) -->
    <record id="action_server_assign_officers_to_team" model="ir.actions.server">
        <field name="name">Assign to Team</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('custom_leads.group_lead_team_lead')),
                                        (4, ref('custom_leads.group_lead_manager')),
                                        (4, ref('custom_leads.group_super_admin'))]"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Assign to Team',
    'res_model': 'team.bulk.assign.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_model': 'res.users', 'active_ids': records.ids},
}
        </field>
    </record>

</odoo>
