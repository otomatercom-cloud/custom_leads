<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_lead_round_robin_wizard_form" model="ir.ui.view">
        <field name="name">lead.round.robin.wizard.form</field>
        <field name="model">lead.round.robin.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Leads — Round Robin">
                <group>
                    <group string="Assignment Settings">
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="lead_count" readonly="1"/>
                    </group>
                    <group string="Rotation Order">
                        <field name="member_preview" readonly="1" widget="char"
                               nolabel="1"
                               style="font-style:italic; color:#555;"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert"
                     invisible="not team_id">
                    <i class="fa fa-info-circle"/> Leads will be distributed one-by-one across team
                    members in the order shown above, cycling back to the first member after
                    the last.
                </div>
                <footer>
                    <button name="action_assign" type="object" string="Assign Leads"
                            class="btn-primary"
                            invisible="not team_id"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server Action bound to leads.logic list view -->
    <record id="action_server_lead_round_robin_assign" model="ir.actions.server">
        <field name="name">Assign to Team (Round Robin)</field>
        <field name="model_id" ref="custom_leads.model_leads_logic"/>
        <field name="binding_model_id" ref="custom_leads.model_leads_logic"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('custom_leads.group_lead_team_lead')),
                                       (4, ref('custom_leads.group_lead_manager')),
                                       (4, ref('custom_leads.group_super_admin'))]"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Assign to Team (Round Robin)',
    'res_model': 'lead.round.robin.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'active_model': 'leads.logic',
        'active_ids': records.ids,
    },
}
        </field>
    </record>

</odoo>
