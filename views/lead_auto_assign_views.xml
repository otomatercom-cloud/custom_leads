<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_auto_assign_pool_tree" model="ir.ui.view">
        <field name="name">lead.auto.assign.pool.tree</field>
        <field name="model">lead.auto.assign.pool</field>
        <field name="arch" type="xml">
            <tree string="Auto Assign Pools">
                <field name="name"/>
                <field name="is_enabled" widget="boolean_toggle"/>
                <field name="member_count"/>
                <field name="last_user_id"/>
                <field name="last_assigned_on"/>
                <field name="assigned_total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_lead_auto_assign_pool_form" model="ir.ui.view">
        <field name="name">lead.auto.assign.pool.form</field>
        <field name="model">lead.auto.assign.pool</field>
        <field name="arch" type="xml">
            <form string="Auto Assign Pool">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_enabled" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="last_user_id"/>
                            <field name="last_assigned_on"/>
                            <field name="assigned_total"/>
                        </group>
                    </group>
                    <separator string="Admission Officers in the Pool (round-robin order = user order)"/>
                    <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Add the Admission Officers who should receive new leads..."/>
                    <div class="text-muted mt-2">
                        Every new lead that comes in without an owner (website, import, API, Digital Team,
                        Tele Callers, Team Lead...) is given to the next officer in this list, one after another.
                        Leads created by an Admission Officer stay with that officer.
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_lead_auto_assign_pool" model="ir.actions.act_window">
        <field name="name">Auto Assign Pool</field>
        <field name="res_model">lead.auto.assign.pool</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the Auto Assign Pool</p>
            <p>Choose the Admission Officers who receive new leads in round-robin order.</p>
        </field>
    </record>

    <menuitem id="menu_lead_auto_assign_pool" name="Auto Assign Pool" parent="leads_main_menu" sequence="10"
              action="action_lead_auto_assign_pool"
              groups="custom_leads.group_lead_team_lead,custom_leads.group_lead_manager,custom_leads.group_super_admin"/>
</odoo>
