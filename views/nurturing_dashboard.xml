<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Client action that loads the OWL nurturing dashboard component -->
    <record id="action_nurturing_dashboard" model="ir.actions.client">
        <field name="name">Nurturing Dashboard</field>
        <field name="tag">custom_leads.nurturing_dashboard</field>
    </record>

    <!-- Menu item — parent: leads_main_menu, right after the stage dashboard -->
    <menuitem id="menu_leads_nurturing_dashboard"
              name="🌱 Nurturing"
              parent="leads_main_menu"
              action="action_nurturing_dashboard"
              sequence="1"/>

</odoo>
