<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         Tree / List View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_lead_re_enquiry_tree" model="ir.ui.view">
        <field name="name">lead.re.enquiry.tree</field>
        <field name="model">lead.re.enquiry</field>
        <field name="arch" type="xml">
            <tree string="Re-Enquiries"
                  decoration-warning="review_state == 'pending'"
                  decoration-success="review_state == 'approved'"
                  decoration-danger="review_state == 'rejected'"
                  decoration-muted="review_state == 'merged'">
                <header>
                    <!-- Bulk Approve -->
                    <button name="action_approve"
                            string="✅ Approve"
                            type="object"
                            groups="custom_leads.group_lead_team_lead,custom_leads.group_lead_manager,custom_leads.group_super_admin"/>
                    <!-- Bulk Reject -->
                    <button name="action_reject"
                            string="❌ Reject"
                            type="object"
                            groups="custom_leads.group_lead_team_lead,custom_leads.group_lead_manager,custom_leads.group_super_admin"/>
                </header>
                <field name="reference_no"/>
                <field name="lead_id"/>
                <field name="lead_name"/>
                <field name="lead_phone"/>
                <field name="lead_owner_id"/>
                <field name="lead_academic_year"/>
                <field name="enquiry_date"/>
                <field name="old_source_id" string="Old Source"/>
                <field name="leads_source" string="New Source"/>
                <field name="campaign"/>
                <field name="course_interested"/>
                <field name="review_state"
                       widget="badge"
                       decoration-warning="review_state == 'pending'"
                       decoration-success="review_state == 'approved'"
                       decoration-danger="review_state == 'rejected'"
                       decoration-info="review_state == 'merged'"/>
                <field name="reviewed_by"/>
            </tree>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Form View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_lead_re_enquiry_form" model="ir.ui.view">
        <field name="name">lead.re.enquiry.form</field>
        <field name="model">lead.re.enquiry</field>
        <field name="arch" type="xml">
            <form string="Re-Enquiry">
                <header>
                    <field name="review_state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected,merged"/>
                    <button name="action_approve"
                            string="✅ Approve"
                            type="object"
                            class="btn-success"
                            invisible="review_state != 'pending'"
                            groups="custom_leads.group_lead_team_lead,
                                    custom_leads.group_lead_manager,
                                    custom_leads.group_super_admin"/>
                    <button name="action_reject"
                            string="❌ Reject"
                            type="object"
                            class="btn-danger"
                            invisible="review_state != 'pending'"
                            groups="custom_leads.group_lead_team_lead,
                                    custom_leads.group_lead_manager,
                                    custom_leads.group_super_admin"/>
                    <button name="action_open_original_lead"
                            string="🔗 Open Original Lead"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Pending Review"
                            bg_color="text-bg-warning"
                            invisible="review_state != 'pending'"/>
                    <widget name="web_ribbon"
                            title="Approved"
                            bg_color="text-bg-success"
                            invisible="review_state != 'approved'"/>
                    <widget name="web_ribbon"
                            title="Rejected"
                            bg_color="text-bg-danger"
                            invisible="review_state != 'rejected'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="reference_no" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Original Lead Snapshot -->
                    <group string="🗂️ Original Lead" col="4">
                        <field name="lead_id"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="lead_name"/>
                        <field name="lead_phone"/>
                        <field name="lead_owner_id"/>
                        <field name="lead_quality"/>
                        <field name="lead_academic_year"/>
                    </group>

                    <!-- Source Comparison -->
                    <group string="📌 Source Comparison" col="2">
                        <field name="old_source_id"
                               string="Old Source (Original Lead)"
                               readonly="1"/>
                        <field name="leads_source"
                               string="New Source (Re-Enquiry)"/>
                    </group>

                    <!-- New Enquiry Details -->
                    <group string="📋 New Enquiry Details" col="4">
                        <field name="enquiry_date"/>
                        <field name="campaign"/>
                        <field name="digital_lead_source"/>
                        <field name="course_interested"/>
                        <field name="created_by" readonly="1"/>
                    </group>

                    <!-- Review -->
                    <group string="🔍 Review"
                           groups="custom_leads.group_lead_team_lead,
                                   custom_leads.group_lead_manager,
                                   custom_leads.group_super_admin"
                           col="4">
                        <field name="review_required"/>
                        <field name="reviewed_by" readonly="1"/>
                        <field name="reviewed_on" readonly="1"/>
                    </group>

                    <group string="Remarks">
                        <field name="remarks" nolabel="1" colspan="4"/>
                    </group>

                    <group string="Review Notes"
                           groups="custom_leads.group_lead_team_lead,
                                   custom_leads.group_lead_manager,
                                   custom_leads.group_super_admin">
                        <field name="review_notes" nolabel="1" colspan="4"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Search View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_lead_re_enquiry_search" model="ir.ui.view">
        <field name="name">lead.re.enquiry.search</field>
        <field name="model">lead.re.enquiry</field>
        <field name="arch" type="xml">
            <search string="Re-Enquiries">
                <field name="reference_no"/>
                <field name="lead_id"/>
                <field name="lead_name"/>
                <field name="lead_phone"/>
                <field name="campaign"/>
                <field name="old_source_id" string="Old Source"/>
                <field name="leads_source" string="New Source"/>
                <separator/>
                <filter name="filter_pending"
                        string="Pending Review"
                        domain="[('review_state','=','pending')]"/>
                <filter name="filter_approved"
                        string="Approved"
                        domain="[('review_state','=','approved')]"/>
                <filter name="filter_rejected"
                        string="Rejected"
                        domain="[('review_state','=','rejected')]"/>
                <filter name="filter_today"
                        string="Today"
                        domain="[('enquiry_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <!-- Filter for Admission Officers: only their leads' re-enquiries -->
                <filter name="filter_my_leads"
                        string="My Leads"
                        domain="[('lead_owner_id.user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_lead"
                            string="Original Lead"
                            context="{'group_by': 'lead_id'}"/>
                    <filter name="grp_old_source"
                            string="Old Source"
                            context="{'group_by': 'old_source_id'}"/>
                    <filter name="grp_source"
                            string="New Source"
                            context="{'group_by': 'leads_source'}"/>
                    <filter name="grp_campaign"
                            string="Campaign"
                            context="{'group_by': 'campaign'}"/>
                    <filter name="grp_state"
                            string="Review State"
                            context="{'group_by': 'review_state'}"/>
                    <filter name="grp_date"
                            string="Enquiry Month"
                            context="{'group_by': 'enquiry_date:month'}"/>
                    <filter name="grp_officer"
                            string="Admission Officer"
                            context="{'group_by': 'lead_owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Action — Team Lead / Manager view (all re-enquiries)
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_lead_re_enquiry" model="ir.actions.act_window">
        <field name="name">Re-Enquiries</field>
        <field name="res_model">lead.re.enquiry</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lead_re_enquiry_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No re-enquiries yet.
            </p>
            <p>
                Re-enquiries are created automatically when a mobile number that
                already exists in the same academic year is submitted again.
                The original lead and its assigned officer stay unchanged.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Action — Admission Officer view (only their leads' re-enquiries)
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_lead_re_enquiry_my" model="ir.actions.act_window">
        <field name="name">My Re-Enquiries</field>
        <field name="res_model">lead.re.enquiry</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lead_re_enquiry_search"/>
        <field name="domain">[('lead_owner_id.user_id','=',uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No re-enquiries for your leads yet.
            </p>
            <p>
                This list shows re-enquiries raised against leads assigned to you.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Menu Items
    ══════════════════════════════════════════════════════════════════ -->

    <!-- Team Lead / Manager menu (all re-enquiries) -->
    <menuitem id="menu_lead_re_enquiry"
              name="🔁 Re-Enquiries"
              action="action_lead_re_enquiry"
              parent="leads_main_menu"
              sequence="25"
              groups="custom_leads.group_lead_team_lead,custom_leads.group_lead_manager,custom_leads.group_super_admin"/>

    <!-- Admission Officer menu (only their re-enquiries) -->
    <menuitem id="menu_lead_re_enquiry_my"
              name="🔁 My Re-Enquiries"
              action="action_lead_re_enquiry_my"
              parent="leads_main_menu"
              sequence="26"
              groups="custom_leads.group_lead_users"/>

</odoo>
