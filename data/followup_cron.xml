<odoo>
    <record id="ir_cron_followup_reminder" model="ir.cron">
        <field name="name">Follow-Up Reminder Notification</field>
        <field name="model_id" ref="custom_leads.model_lead_followup"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_upcoming_followups()</field>
        <field name="active">True</field>
        <field name="interval_type">hours</field>
        <field name="interval_number">1</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
