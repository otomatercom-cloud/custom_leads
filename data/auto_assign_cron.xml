<odoo>
    <record id="ir_cron_auto_assign_pending" model="ir.cron">
        <field name="name">Lead Round Robin: assign waiting leads</field>
        <field name="model_id" ref="custom_leads.model_lead_auto_assign_pool"/>
        <field name="state">code</field>
        <field name="code">model._cron_assign_pending()</field>
        <field name="active">True</field>
        <field name="interval_type">minutes</field>
        <field name="interval_number">5</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
